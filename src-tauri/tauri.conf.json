{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daymark",
  "version": "0.1.0",
  "identifier": "com.daymark.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Daymark",
        "width": 1100,
        "height": 760,
        "minWidth": 850,
        "minHeight": 600
      },
      {
        "label": "quick-add",
        "title": "Daymark Quick Add",
        "url": "index.html#quick-add",
        "width": 640,
        "height": 130,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
